{
  "triggers": [
    {
      "id": "thermostat_hc1_hpoperatingstate_changed",
      "title": {
        "en": "Heatpump operating state changed"
      },
      "tokens": [
        {
          "type": "string",
          "name": "thermostat_hc1_hpoperatingstate",
          "title": {
            "en": "Operating state"
          },
          "example": {
            "en": "Heating"
          }
        }
      ]
    },
    {
      "id": "thermostat_outdoor_temp_crossed_above",
      "title": {
        "en": "Outdoor temperature went above..."
      },
      "titleFormatted": {
        "en": "Outdoor temperature went above [[temp]]°C"
      },
      "args": [
        {
          "type": "number",
          "name": "temp",
          "placeholder": { "en": "0" },
          "min": -50,
          "max": 50,
          "step": 0.5
        }
      ],
      "tokens": [
        {
          "type": "number",
          "name": "outdoor_temp",
          "title": { "en": "Outdoor temperature" },
          "example": { "en": "12" }
        }
      ]
    },
    {
      "id": "thermostat_outdoor_temp_crossed_below",
      "title": {
        "en": "Outdoor temperature went below..."
      },
      "titleFormatted": {
        "en": "Outdoor temperature went below [[temp]]°C"
      },
      "args": [
        {
          "type": "number",
          "name": "temp",
          "placeholder": { "en": "0" },
          "min": -50,
          "max": 50,
          "step": 0.5
        }
      ],
      "tokens": [
        {
          "type": "number",
          "name": "outdoor_temp",
          "title": { "en": "Outdoor temperature" },
          "example": { "en": "5" }
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "thermostat_set_hc_target_temp",
      "title": {
        "en": "Set heating circuit target temperature"
      },
      "titleFormatted": {
        "en": "Set HC[[circuit]] target temperature to [[temperature]]°C"
      },
      "args": [
        {
          "type": "autocomplete",
          "name": "circuit",
          "placeholder": {
            "en": "Select circuit"
          }
        },
        {
          "type": "range",
          "name": "temperature",
          "min": 5,
          "max": 30,
          "step": 0.5,
          "label": {
            "en": "°C"
          },
          "labelDecimals": 1
        }
      ]
    },
    {
      "id": "thermostat_adjust_hc_target_temp_offset",
      "title": {
        "en": "Adjust heating circuit target temperature"
      },
      "titleFormatted": {
        "en": "Adjust HC[[circuit]] target temperature by [[offset]]°C"
      },
      "args": [
        {
          "type": "autocomplete",
          "name": "circuit",
          "placeholder": {
            "en": "Select circuit"
          }
        },
        {
          "type": "range",
          "name": "offset",
          "min": -5,
          "max": 5,
          "step": 0.5,
          "label": {
            "en": "°C"
          },
          "labelDecimals": 1
        }
      ]
    },
    {
      "id": "thermostat_set_hc_summer_mode",
      "title": {
        "en": "Set heating circuit summer mode"
      },
      "titleFormatted": {
        "en": "Set HC[[circuit]] summer mode to [[mode]]"
      },
      "args": [
        {
          "type": "autocomplete",
          "name": "circuit",
          "placeholder": {
            "en": "Select circuit"
          }
        },
        {
          "type": "dropdown",
          "name": "mode",
          "values": [
            { "id": "summer", "label": { "en": "Summer" } },
            { "id": "auto", "label": { "en": "Auto" } },
            { "id": "winter", "label": { "en": "Winter" } }
          ]
        }
      ]
    },
    {
      "id": "thermostat_set_hc_mode",
      "title": {
        "en": "Set heating circuit operating mode"
      },
      "titleFormatted": {
        "en": "Set HC[[circuit]] operating mode to [[mode]]"
      },
      "args": [
        {
          "type": "autocomplete",
          "name": "circuit",
          "placeholder": {
            "en": "Select circuit"
          }
        },
        {
          "type": "dropdown",
          "name": "mode",
          "values": [
            { "id": "off", "label": { "en": "Off" } },
            { "id": "manual", "label": { "en": "Manual" } },
            { "id": "auto", "label": { "en": "Auto" } }
          ]
        }
      ]
    }
  ]
}
