            "title": {
              "en": "Partition identifier"
            },
            "placeholder": {
              "en": "room_name"
            },
            "hint": {
              "en": "The key to use for identifying different cooldown partitions. This could be the zone name, device ID, etc. Best is to also prefix that with a unique name for the flow card."
