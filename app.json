        },
        "titleFormatted": {
          "en": "Cooldown for [[cooldownTime]] seconds per [[partitionKey]]"
        },
        "hint": {
          "en": "Allows immediate triggers but blocks follow-up triggers until there's a gap of no events for the specified time. Each unique entity partition key will have its own cooldown timer. Partitions are shared between all cards, so make them unique."
        },
        "args": [
          {
            "type": "number",
            "name": "cooldownTime",
